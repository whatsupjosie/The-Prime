+    'tortoise-dark':['Dark Tortoiseshell','deep layered shell pattern','radial-gradient(ellipse at 28% 25%,#9b5422 0 18%,transparent 20%),radial-gradient(ellipse at 73% 70%,#2c1710 0 28%,transparent 30%),#4a2818'],
+    'tortoise-red':['Red Tortoiseshell','warm translucent pattern','radial-gradient(ellipse at 24% 28%,#d77a3f 0 18%,transparent 20%),radial-gradient(ellipse at 72% 66%,#5b1d13 0 24%,transparent 27%),#7d3420'],
+    'tortoise-olive':['Olive Tortoiseshell','green-brown layered pattern','radial-gradient(ellipse at 28% 30%,#9a9b4a 0 18%,transparent 20%),radial-gradient(ellipse at 70% 68%,#2e3517 0 26%,transparent 28%),#554c25'],
