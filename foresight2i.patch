+/* Shapes: shield, shell, petal, fan, plaque, lantern. */
+.panel.preview{--shape:polygon(7% 0,88% 0,96% 6%,100% 18%,100% 82%,95% 94%,88% 100%,10% 100%,3% 94%,0 80%,2% 17%)}
+.panel.chat{--shape:polygon(10% 0,89% 0,97% 8%,100% 30%,98% 87%,90% 96%,72% 100%,12% 100%,3% 92%,0 74%,2% 14%)}
