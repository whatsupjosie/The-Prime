+// ── AI GENERATION ──────────────────────────────────────────────────
+// Builds the intelligence portion of the generation prompt: active
+// (unresolved) plot threads and characters who appear in the current
+// chapter, so generation is grounded in what the indexer already knows
+// instead of only the raw last-8-lines window.
+function buildIntelligenceContext() {
+  if (!intelligence) return '';
+  const chIdx = currentChapterIndex();
+  const parts = [];
+
+  const activeThreads = (intelligence.plot_threads || []).filter(t => t.status !== 'resolved');
+  if (activeThreads.length) {
+    parts.push('Active plot threads: ' + activeThreads.map(t => t.label).join(', ') + '.');
+  }
+
+  const chapterChars = (intelligence.characters || []).filter(c =>
+    (c.appearances || []).some(a => a.chapter === chIdx));
+  if (chapterChars.length) {
+    const charLines = chapterChars.map(c => {
+      const traits = [...(c.traits?.confirmed || []), ...(c.traits?.inferred || [])];
+      return traits.length ? `${c.name} (${traits.slice(0, 4).join(', ')})` : c.name;
+    });
+    parts.push('Characters in this chapter: ' + charLines.join('; ') + '.');
+  }
+
+  const openFlags = (intelligence.continuity_flags || [])
+    .filter(f => f.status === 'active' && f.severity !== 'info' && (f.chapters || []).includes(chIdx));
+  if (openFlags.length) {
+    parts.push('Unresolved continuity notes for this chapter: ' + openFlags.map(f => f.message).join('; ') + '.');
+  }
