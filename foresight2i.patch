+      manuscriptLines.appendChild(div);
+    }
+    lineNum++;
+  });
+
+  // Follow new prose only when the reader was already at the bottom.
+  manuscriptZone.scrollTop = wasAtBottom ? manuscriptZone.scrollHeight : prevScroll;
+}
+
+function renderReading() {
