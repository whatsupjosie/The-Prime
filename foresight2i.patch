+    presets.forEach(name=>{const b=document.createElement('button');b.className='light-preset';b.innerHTML='<b>'+name.replaceAll('_',' ')+'</b><small>Apply through lighting service</small>';b.onclick=async()=>{try{const d=await api('/api/lighting',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({preset:name})});applyLighting(d.state);toast('Lighting: '+name.replaceAll('_',' '));lp.querySelectorAll('.light-preset').forEach(x=>x.classList.remove('selected'));b.classList.add('selected')}catch(e){toast('Lighting service unavailable')}};lp.appendChild(b)});
