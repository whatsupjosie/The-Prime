+  actions.appendChild(dismissBtn); actions.appendChild(laterBtn); actions.appendChild(fixBtn);
+  div.appendChild(actions);
+  chatLog.appendChild(div);
+  chatLog.scrollTop = chatLog.scrollHeight;
+}
+
+function setFlagStatus(id, status) {
+  const flag = intelligence.continuity_flags.find(f => f.id === id);
+  if (!flag) return;
+  flag.status = status;
+  flag.dismissed = status === 'dismissed';
+  markDirty();
+}
+
+// Detects previously-flagged issues that no longer reproduce — i.e. the
+// writer fixed them. Runs findings against still-active flags for this
+// chapter; anything not present in the new findings is marked resolved.
+function resolveFixedFlags(idx, findings) {
+  const stillPresent = new Set((findings || []).map(f => f.type + '::' + f.message));
+  intelligence.continuity_flags
+    .filter(f => f.status === 'active' && (f.chapters || []).includes(idx))
+    .forEach(f => { if (!stillPresent.has(f.type + '::' + f.message)) f.status = 'resolved'; });
+}
+
+async function runContinuityCheck(idx) {
+  if (!llmOk()) return;
+  try {
+    const reply = await callLLM([{ role: 'user', content: CONTINUITY_SYSTEM_PROMPT + '\n\n' + buildContinuityUserPrompt(idx) }]);
+    const data = parseContinuityReply(reply);
+    const findings = data && Array.isArray(data.findings) ? data.findings : [];
+    resolveFixedFlags(idx, findings);
+    const added = mergeContinuityFlags(idx, findings);
+    added.forEach(renderContinuityFlag);
+    if (added.length) markDirty();
+  } catch (e) {
+    console.warn('Continuity check failed for chapter', idx, e); // silent — not critical path
+  }
+}
