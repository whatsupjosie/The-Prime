+.dashboard{background:radial-gradient(ellipse at 50% 40%,rgba(151,100,46,.035),transparent 55%);}
+
+/* Each tray is now a physical silhouette. */
+.dashboard>.panel{border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important;isolation:isolate}
+.dashboard>.panel:before{content:"";position:absolute;inset:0;z-index:-2;border:0!important;border-radius:0!important;background:
+ linear-gradient(145deg,rgba(28,30,29,.96),rgba(9,12,13,.97));
+ clip-path:var(--shape);box-shadow:0 25px 70px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,236,204,.08)}
+.dashboard>.panel:after{content:"";position:absolute;inset:7px;z-index:-1;border:1px solid rgba(197,143,79,.35);background:transparent;clip-path:var(--shape);box-shadow:inset 0 0 0 1px rgba(255,214,157,.025);pointer-events:none}
+.panel-head{position:relative;padding:18px 24px 11px!important;letter-spacing:.15em!important;color:#c9b79e!important}
