+<style id="foresight-v18-polygon-trays">
+/* ───────────────────────────────────────────────────────────────────────
+   V18 — POLYGONAL TRAYS + TRAY LAUNCHER
+   Replaces the rectangular tray chrome with spec-compliant irregular
+   polygons, and restores the tray show/hide menu.
+
+   Deliberately does NOT touch position or size: trays live on the counter
+   and the freeform workspace owns where they sit. This layer only changes
+   what a tray *looks like*, never where it *is*.
+
+   Shared visual grammar is non-negotiable — every family uses the same
+   stroke recipe, glow behaviour, gradient and light logic.
+   ─────────────────────────────────────────────────────────────────────── */
+
+/* The polygon becomes the surface, so the box drops its rectangular chrome.
+   Width/height/left/top are left alone — the counter owns those. */
+:root[data-tray-geometry="polygonal"] .panel{
+  background:none!important;
+  border:0!important;
+  border-radius:0!important;
+  box-shadow:none!important;
+  overflow:visible!important;
+}
+
+.tray-shape{
+  position:absolute;inset:0;width:100%;height:100%;
+  pointer-events:none;z-index:0;overflow:visible;
+}
+.tray-shape .tray-fill{fill:rgba(15,19,22,.86)}
+.tray-shape .tray-stroke{
+  fill:none;
+  stroke:var(--user-accent,#c98f4a);
+  stroke-width:1.4;
+  stroke-opacity:.72;
+  /* Softened perimeter — the unifier that makes every family read as a set. */
+  filter:url(#trayFeather);
+  transition:stroke-opacity .25s ease;
+}
+.tray-shape .tray-glow{
+  fill:none;stroke:var(--user-accent,#c98f4a);stroke-width:7;
+  filter:url(#trayFeather);opacity:.2;transition:opacity .25s ease;
+}
+
+/* Focus/glow response is identical regardless of silhouette. */
+.panel:hover .tray-stroke,.panel:focus-within .tray-stroke{stroke-opacity:1}
+.panel:hover .tray-glow,.panel:focus-within .tray-glow{opacity:.46}
+.panel.tray-collision .tray-stroke{stroke:#e6b073;stroke-opacity:.95}
+
+/* Tray content rides above the silhouette, inset off the polygon edge. */
+:root[data-tray-geometry="polygonal"] .panel>.tray-content{
+  position:relative;z-index:1;height:100%;
+  display:flex;flex-direction:column;overflow:hidden;
+  padding:var(--tray-pad,18px) var(--tray-pad-x,22px);
+}
+:root[data-tray-geometry="polygonal"] .panel>.tray-content>*{min-height:0}
+
+/* ── Tray launcher — restores show/hide, which renderMenu() left unbuilt ── */
+:root[data-tray-geometry="polygonal"] .tray-launcher{
+  display:flex!important;                     /* v15 had hidden this outright */
+  position:fixed;left:50%;bottom:14px;transform:translateX(-50%);
+  gap:6px;padding:7px 10px;z-index:900;
+  background:rgba(10,13,15,.82);
+  border:1px solid color-mix(in srgb,var(--user-accent,#c98f4a) 30%,transparent);
+  border-radius:999px;
+  box-shadow:0 10px 30px rgba(0,0,0,.55);
+  backdrop-filter:blur(9px);
+  max-width:min(92vw,880px);flex-wrap:wrap;justify-content:center;
+}
+.tray-launcher-btn{
+  font:inherit;font-size:9px;letter-spacing:.09em;text-transform:uppercase;
+  padding:5px 11px;border-radius:999px;cursor:pointer;
+  background:transparent;color:rgba(233,224,208,.55);
+  border:1px solid transparent;transition:all .15s ease;
+}
+.tray-launcher-btn:hover{color:#f2e7d5;border-color:color-mix(in srgb,var(--user-accent,#c98f4a) 45%,transparent)}
+.tray-launcher-btn[aria-pressed="true"]{
+  color:var(--user-accent,#c98f4a);
+  border-color:color-mix(in srgb,var(--user-accent,#c98f4a) 55%,transparent);
+  background:color-mix(in srgb,var(--user-accent,#c98f4a) 12%,transparent);
+}
+.tray-launcher-btn:focus-visible{outline:2px solid var(--user-accent,#c98f4a);outline-offset:2px}
+.panel.tray-hidden{display:none!important}
+</style>
+
+<script id="foresight-v18-polygon-trays-script">
+/* Paints the exported silhouettes onto the trays and restores the launcher.
+   Geometry is generated and validated in Python (polygon_shape_library.py,
+   covered by test_polygon_shape_library.py) and exported to
+   tray_silhouettes.json, so the browser can never drift from the rules. */
+(function () {
+  const SVG = 'http://www.w3.org/2000/svg';
+
+  function installFilter(feather) {
+    if (document.getElementById('trayFeatherDefs')) return;
+    const s = document.createElementNS(SVG, 'svg');
+    s.id = 'trayFeatherDefs';
+    s.setAttribute('width', '0'); s.setAttribute('height', '0');
+    s.style.cssText = 'position:absolute;width:0;height:0;pointer-events:none';
+    s.innerHTML =
+      '<defs><filter id="trayFeather" x="-25%" y="-25%" width="150%" height="150%">' +
+      '<feGaussianBlur stdDeviation="' + feather.toFixed(2) + '"/></filter></defs>';
+    document.body.appendChild(s);
+  }
+
+  function paint(panel, spec) {
+    if (panel.querySelector(':scope > .tray-shape')) return;
+
+    // Wrap existing children so they sit inside the polygon, not its bbox.
+    const content = document.createElement('div');
+    content.className = 'tray-content';
+    while (panel.firstChild) content.appendChild(panel.firstChild);
+
+    const svg = document.createElementNS(SVG, 'svg');
+    svg.setAttribute('class', 'tray-shape');
+    svg.setAttribute('viewBox', spec.viewBox);
+    svg.setAttribute('preserveAspectRatio', 'none');
+    svg.setAttribute('aria-hidden', 'true');
+    ['tray-glow', 'tray-fill', 'tray-stroke'].forEach(cls => {
+      const p = document.createElementNS(SVG, 'path');
+      p.setAttribute('d', spec.path);
+      p.setAttribute('class', cls);
+      svg.appendChild(p);
+    });
+
+    panel.appendChild(svg);
+    panel.appendChild(content);
+
+    // Pad content in from the polygon edge, proportional to the inset the
+    // shape library computed for this silhouette.
+    const inX = Math.round(spec.inset.x + 6), inY = Math.round(spec.inset.y + 4);
+    content.style.setProperty('--tray-pad', inY + 'px');
+    content.style.setProperty('--tray-pad-x', inX + 'px');
+    panel.dataset.trayFamily = spec.family;
+  }
+
+  /* renderMenu() shipped as an empty stub, so hideTray()/showTray() were
+     reachable in code but had no UI. This rebuilds that launcher. */
+  function buildLauncher(ids) {
+    let bar = document.querySelector('.tray-launcher');
+    if (!bar) {
+      bar = document.createElement('div');
+      bar.className = 'tray-launcher';
+      bar.setAttribute('role', 'group');
+      bar.setAttribute('aria-label', 'Show or hide trays');
+      document.body.appendChild(bar);
+    }
+    bar.innerHTML = '';
+    ids.forEach(id => {
+      const panel = document.querySelector('.panel.' + id);
+      if (!panel) return;
+      const b = document.createElement('button');
+      b.className = 'tray-launcher-btn';
+      b.type = 'button';
+      b.textContent = id;
+      const sync = () => {
+        const on = !panel.classList.contains('tray-hidden');
+        b.setAttribute('aria-pressed', String(on));
+        b.title = (on ? 'Hide ' : 'Show ') + id + ' tray';
+      };
+      b.addEventListener('click', () => {
+        panel.classList.toggle('tray-hidden');
+        sync();
+      });
+      sync();
+      bar.appendChild(b);
+    });
+    return bar;
+  }
+
+  async function apply() {
+    let data;
+    try {
+      const res = await fetch('tray_silhouettes.json', { cache: 'no-store' });
+      if (!res.ok) throw new Error('HTTP ' + res.status);
+      data = await res.json();
+    } catch (e) {
+      // file:// or missing export — leave the tray chrome exactly as it was
+      // rather than half-applying the polygon treatment.
+      console.warn('[v18] silhouettes unavailable, keeping rectangular trays:', e.message);
+      return;
+    }
+
+    const ids = Object.keys(data);
+    installFilter(data[ids[0]] ? data[ids[0]].feather : 0.7);
+    ids.forEach(id => {
+      const panel = document.querySelector('.panel.' + id);
+      if (panel) paint(panel, data[id]);
+    });
+    buildLauncher(ids);
+    document.documentElement.setAttribute('data-tray-geometry', 'polygonal');
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', apply);
+  } else {
+    apply();
+  }
+})();
+</script>
