+<style id="foresight-v7-interaction-refine">
+/* V7: remove the invisible parent clip so every tray corner remains interactive. */
+.dashboard>.panel{clip-path:none!important;overflow:hidden!important;}
+.dashboard>.panel:before,.dashboard>.panel:after{pointer-events:none!important;}
+.panel-head.tray-head{display:flex!important;align-items:center!important;gap:10px!important;}
+.panel-head.tray-head .tray-status{margin-left:auto!important;white-space:nowrap;}
+.panel-head.tray-head .tray-actions{margin-left:0!important;flex:0 0 auto;}
+.panel-head.tray-head b{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
+/* Let the tray's ornamental skin, not the rectangular DOM box, define its visible boundary. */
+.dashboard>.panel{background:transparent!important;border:0!important;box-shadow:none!important;}
+.dashboard>.panel:before{z-index:0!important;background:
+  radial-gradient(circle at 17% 10%,rgba(225,177,108,.10),transparent 23%),
+  linear-gradient(145deg,rgba(28,31,31,.98),rgba(8,11,12,.985));
+  box-shadow:0 25px 70px rgba(0,0,0,.58),inset 0 1px 0 rgba(255,237,204,.08),inset 0 0 0 1px rgba(201,145,79,.12)!important;}
+.dashboard>.panel:after{z-index:1!important;}
+.dashboard>.panel>*{position:relative;z-index:3;}
+.dashboard>.panel .tray-label,.dashboard>.panel .resize-grip{z-index:20!important;}
+/* The files become a family of small plaques rather than four cards in a row. */
+.files .file-row{align-items:stretch!important;}
