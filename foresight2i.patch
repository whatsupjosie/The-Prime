+/* Conversation becomes a softer asymmetric dialogue chamber. */
+.chat .msg{border:0!important;background:rgba(26,25,26,.65)!important;position:relative;box-shadow:none!important}
+.chat .msg:before{content:"";position:absolute;inset:0;border:1px solid rgba(190,139,80,.19);clip-path:polygon(8% 0,94% 0,100% 18%,100% 82%,92% 100%,7% 100%,0 82%,0 18%);pointer-events:none}
