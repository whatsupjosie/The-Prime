+.panel.files{--shape:polygon(5% 0,95% 0,100% 14%,97% 88%,91% 100%,8% 100%,0 88%,2% 12%)}
+.panel.memory{--shape:polygon(50% 0,88% 7%,98% 28%,100% 70%,88% 93%,50% 100%,12% 93%,0 70%,2% 28%,12% 7%)}
+.panel.tools{--shape:polygon(12% 0,88% 0,100% 18%,96% 84%,86% 100%,12% 100%,0 84%,4% 18%)}
