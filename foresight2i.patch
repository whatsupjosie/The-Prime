@@ -0,0 +1,17 @@
+{
+  "name": "pubcast-2i-backend",
+  "version": "1.0.0",
+  "description": "Backend proxy for Pubcast 2i Writer's Room — keeps API keys server-side and unblocks Claude CORS + future word-tool integrations.",
+  "main": "server.js",
+  "type": "commonjs",
+  "scripts": {
+    "start": "node server.js",
+    "dev": "node --watch server.js"
+  },
+  "dependencies": {
+    "express": "^4.19.2",
+    "cors": "^2.8.5",
+    "dotenv": "^16.4.5",
+    "node-fetch": "^2.7.0"
+  }
+}
diff --git a/2i/backend/server.js b/2i/backend/server.js
new file mode 100644
index 0000000..3b01dea
--- /dev/null
+++ b/2i/backend/server.js
@@ -0,0 +1,122 @@
+// Pubcast 2i — Backend Proxy
+//
+// Two jobs:
+//   1. /api/claude    — proxies calls to Anthropic's API so the key never
+//                        lives in the browser (fixes the CORS limitation
+//                        noted in the v20 HANDOFF.md).
+//   2. /api/thesaurus  — word-lookup passthrough (synonyms, rhymes, related
+//                        words). Wired to Datamuse (free, no key required)
+//                        as a working default. Swap providers later by
+//                        editing only this route.
+//
+// Run:
+//   cp .env.example .env   # fill in ANTHROPIC_API_KEY
+//   npm install
+//   npm start
+//
+// Point the app's LLM settings at http://localhost:8787/api/claude
+// instead of calling Anthropic directly from the browser.
+
+require('dotenv').config();
+const express = require('express');
+const cors = require('cors');
+const fetch = require('node-fetch');
+
+const app = express();
+const PORT = process.env.PORT || 8787;
+
+app.use(cors());
+app.use(express.json({ limit: '2mb' }));
+
+// ── Health check ────────────────────────────────────────────────────
+app.get('/api/health', (req, res) => {
+  res.json({
+    ok: true,
+    claudeConfigured: Boolean(process.env.ANTHROPIC_API_KEY),
+    time: new Date().toISOString()
+  });
+});
+
+// ── Claude proxy ────────────────────────────────────────────────────
+// Body shape matches what the frontend's LLM adapter already sends:
+// { model, max_tokens, messages }
+app.post('/api/claude', async (req, res) => {
+  const apiKey = process.env.ANTHROPIC_API_KEY;
+  if (!apiKey) {
+    return res.status(500).json({ error: 'ANTHROPIC_API_KEY not set on server. See .env.example.' });
+  }
+  const { model, max_tokens, messages, system } = req.body || {};
+  if (!Array.isArray(messages) || !messages.length) {
+    return res.status(400).json({ error: 'messages[] is required' });
+  }
+
+  try {
+    const upstream = await fetch('https://api.anthropic.com/v1/messages', {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        'x-api-key': apiKey,
+        'anthropic-version': '2023-06-01'
+      },
+      body: JSON.stringify({
+        model: model || 'claude-sonnet-4-6',
+        max_tokens: max_tokens || 1000,
+        messages,
+        ...(system ? { system } : {})
+      })
+    });
+
+    const data = await upstream.json();
+    if (!upstream.ok) {
+      return res.status(upstream.status).json({ error: data?.error?.message || 'Anthropic API error', detail: data });
+    }
+    res.json(data);
+  } catch (err) {
+    console.error('Claude proxy error:', err);
+    res.status(502).json({ error: 'Failed to reach Anthropic API', detail: String(err) });
+  }
+});
+
+// ── Thesaurus / word-finder ─────────────────────────────────────────
+// mode: "synonyms" | "rhymes" | "related" | "means-like" (default: synonyms)
+// Backed by Datamuse (https://api.datamuse.com) — free, no API key, good
+// enough to ship today. Swap the fetch URL below if you later move to a
+// paid provider (Merriam-Webster, WordsAPI, etc.) — the response shape
+// returned to the frontend stays the same either way.
+app.get('/api/thesaurus', async (req, res) => {
+  const { word, mode = 'synonyms' } = req.query;
+  if (!word || typeof word !== 'string') {
+    return res.status(400).json({ error: 'word query param is required' });
+  }
+
+  const paramByMode = {
+    synonyms: `rel_syn=${encodeURIComponent(word)}`,
+    rhymes: `rel_rhy=${encodeURIComponent(word)}`,
+    related: `ml=${encodeURIComponent(word)}`,      // "means like" — broader associative matches
+    'means-like': `ml=${encodeURIComponent(word)}`
+  };
+  const qs = paramByMode[mode] || paramByMode.synonyms;
+
+  try {
+    const upstream = await fetch(`https://api.datamuse.com/words?${qs}&max=20`);
+    if (!upstream.ok) throw new Error(`Datamuse ${upstream.status}`);
+    const raw = await upstream.json();
+    res.json({
+      word,
+      mode,
+      results: raw.map(r => ({ word: r.word, score: r.score }))
+    });
+  } catch (err) {
+    console.error('Thesaurus proxy error:', err);
+    res.status(502).json({ error: 'Failed to reach word-lookup provider', detail: String(err) });
+  }
+});
+
+app.listen(PORT, () => {
+  console.log(`Pubcast 2i backend running on http://localhost:${PORT}`);
+  console.log(`  Claude proxy:    POST http://localhost:${PORT}/api/claude`);
+  console.log(`  Thesaurus proxy: GET  http://localhost:${PORT}/api/thesaurus?word=happy&mode=synonyms`);
+  if (!process.env.ANTHROPIC_API_KEY) {
+    console.warn('  ⚠ ANTHROPIC_API_KEY not set — /api/claude will return 500 until you add it to .env');
+  }
+});
diff --git a/2i/index.html b/2i/index.html
new file mode 100644
index 0000000..d02b5c1
--- /dev/null
+++ b/2i/index.html
@@ -0,0 +1,2684 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>Pubcast 2i — Writer's Room</title>
+<style>
+@import url('https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&family=Cinzel+Decorative:wght@400;700&display=swap');
+
+/* ═══════════════════════════════════════════════════════════════
+   DESIGN TOKENS
+   ═══════════════════════════════════════════════════════════════ */
+:root {
+  --ivory:#f9f4e6; --ivory-deep:#efe4cc; --ivory-glow:#fffbf0;
+  --gold:#cda349; --gold-bright:#eecf83; --gold-deep:#93701f;
+  --gold-glow:rgba(238,207,131,0.45); --gold-dim:rgba(205,163,73,0.18);
+  --ink:#231f18; --pencil:#4a4032; --pencil-soft:#7c7160;
+  --mahogany:#3a2013; --mahogany-deep:#1b0f09;
+  --leather:#2c1608; --leather-seam:rgba(0,0,0,0.28);
+  --velvet:#2e6b52; --velvet-glow:rgba(46,107,82,0.38);
+  --parchment:#ecdfc3; --parchment-soft:#c3b391;
+  --danger:#a24a3a; --danger-glow:rgba(162,74,58,0.3);
+  --paper:#f6ecd5; --paper-aged:#f1e4c8; --paper-line:rgba(160,140,110,0.22);
+  --margin-red:rgba(180,60,50,0.28);
+  --glass-border:rgba(205,163,73,0.32);
+  --frame-shadow:0 22px 46px -20px rgba(0,0,0,.85),
+    inset 0 2px 0 rgba(255,225,150,.18),
+    inset 0 -4px 8px rgba(0,0,0,.72);
+}
+*, *::before, *::after { box-sizing:border-box; }
+html, body {
+  height:100%; margin:0; overflow:hidden;
+  font-family:'Cormorant Garamond',serif;
+  color:var(--parchment);
+  background:
+    radial-gradient(ellipse 55% 32% at 50% 0%, rgba(238,207,131,0.10), transparent 62%),
+    radial-gradient(ellipse 45% 30% at 12% 105%, rgba(46,107,82,0.07), transparent 60%),
+    linear-gradient(165deg, #2c190f 0%, #1d1009 55%, #130a05 100%);
+}
+
+/* ═══════════════════════════════════════════════════════════════
+   LAYOUT SHELL
+   ═══════════════════════════════════════════════════════════════ */
+.app-shell {
+  display:grid;
+  grid-template-rows: 42px 1fr 32px;
+  height:100vh;
+}
+
+/* --- TOP BAR --- */
+.top-bar {
+  display:flex; align-items:center; gap:12px;
+  padding:0 16px;
+  background:linear-gradient(180deg, rgba(44,22,8,0.95), rgba(27,15,9,0.98));
+  border-bottom:1px solid rgba(205,163,73,0.25);
+  box-shadow:0 2px 12px rgba(0,0,0,0.5);
+  z-index:20;
+}
+.top-logo {
+  font-family:'Cinzel Decorative',serif;
+  font-size:14px; font-weight:700;
+  color:var(--gold-bright);
+  text-shadow:0 1px 3px rgba(0,0,0,0.6), 0 0 12px rgba(238,207,131,0.15);
+  white-space:nowrap;
+  letter-spacing:0.04em;
+}
+.top-logo small {
+  font-family:'IBM Plex Mono',monospace;
+  font-size:9px; font-weight:400;
+  color:var(--parchment-soft);
+  display:block; margin-top:-2px;
+  letter-spacing:0.08em;
+}
+.top-tabs {
+  display:flex; gap:2px;
+  margin:0 auto;
+  background:rgba(0,0,0,0.25);
+  border-radius:6px; padding:3px;
+}
+.top-tab {
+  font-family:'IBM Plex Mono',monospace;
+  font-size:10px; letter-spacing:0.08em; text-transform:uppercase;
+  padding:5px 14px; border-radius:4px;
+  border:none; cursor:pointer;
+  color:var(--parchment-soft);
+  background:transparent;
+  transition:all 0.15s ease;
+  box-shadow:none;
+}
+.top-tab:hover { color:var(--parchment); background:rgba(205,163,73,0.12); }
+.top-tab.active {
+  color:var(--gold-bright);
+  background:rgba(205,163,73,0.22);
+  box-shadow:inset 0 0 0 1px rgba(205,163,73,0.3);
+}
+.top-right {
+  display:flex; align-items:center; gap:10px;
+  margin-left:auto;
+}
+.mode-badge {
+  font-family:'IBM Plex Mono',monospace;
+  font-size:9px; letter-spacing:0.1em; text-transform:uppercase;
+  padding:4px 10px; border-radius:4px;
+  border:1px solid var(--glass-border);
+  cursor:pointer;
+  transition:all 0.15s ease;
+}
+.mode-badge.write {
+  color:#bff2c8; border-color:rgba(46,107,82,0.5);
+  background:rgba(46,107,82,0.15);
+}
+.mode-badge.collab {
+  color:var(--gold-bright); border-color:var(--glass-border);
+  background:rgba(205,163,73,0.12);
+}
+.top-icon-btn {
+  width:28px; height:28px; border-radius:50%;
+  border:1px solid rgba(205,163,73,0.25);
+  background:rgba(0,0,0,0.2);
+  color:var(--parchment-soft);
+  font-size:13px; cursor:pointer;
+  display:flex; align-items:center; justify-content:center;
+  transition:all 0.15s ease;
+  padding:0;
+  box-shadow:none;
+}
+.top-icon-btn:hover { border-color:var(--gold); color:var(--gold-bright); background:rgba(205,163,73,0.12); }
+
+/* --- MAIN AREA --- */
+.main-area {
+  display:grid;
+  grid-template-columns: 280px 1fr;
+  min-height:0; overflow:hidden;
+  gap:0;
+}
+.main-area.sidebar-hidden { grid-template-columns: 0px 1fr; }
+.main-area.sidebar-hidden .sidebar { display:none; }
+
+/* --- LEFT SIDEBAR --- */
+.sidebar {
+  display:flex; flex-direction:column;
+  background:linear-gradient(180deg, rgba(44,22,8,0.92), rgba(20,11,6,0.96));
+  border-right:1px solid rgba(205,163,73,0.18);
+  overflow:hidden; min-height:0;
+}
+.sidebar-section {
+  display:flex; flex-direction:column;
+  border-bottom:1px solid rgba(205,163,73,0.12);
+  min-height:0;
+}
+.sidebar-section.collapsed > :not(.section-header) { display:none; }
+.section-header {
+  font-family:'IBM Plex Mono',monospace;
+  font-size:9.5px; letter-spacing:0.1em; text-transform:uppercase;
+  color:var(--gold);
+  padding:10px 14px 8px;
+  display:flex; align-items:center; gap:8px;
+  cursor:pointer;
+  user-select:none;
+  border:none; background:none; width:100%; text-align:left;
+  box-shadow:none;
+}
+.section-header::before {
+  content:''; width:5px; height:5px; border-radius:50%;
+  background:var(--gold);
+  box-shadow:0 0 6px rgba(238,207,131,0.6);
+  flex-shrink:0;
+}
+.section-header .collapse-arrow {
+  margin-left:auto; font-size:8px; color:var(--parchment-soft);
+  transition:transform 0.2s ease;
+}
+.sidebar-section.collapsed .collapse-arrow { transform:rotate(-90deg); }
+.section-body { padding:0 14px 12px; display:flex; flex-direction:column; gap:8px; }
+
+/* Manuscript control */
+.mc-row {
+  display:flex; justify-content:space-between; align-items:center;
+  font-family:'IBM Plex Mono',monospace; font-size:10px;
+  color:var(--parchment-soft);
+}
+.mc-progress {
+  width:100%; height:6px; border-radius:3px;
+  background:rgba(0,0,0,0.3);
+  border:1px solid rgba(205,163,73,0.15);
+  overflow:hidden;
+}
+.mc-progress-fill {
+  height:100%; border-radius:2px;
+  background:linear-gradient(90deg, var(--gold-deep), var(--gold-bright));
+  transition:width 0.3s ease;
+}
+.mc-btn-row { display:flex; gap:6px; }
+.mc-btn {
+  flex:1; font-family:'IBM Plex Mono',monospace;
+  font-size:9.5px; letter-spacing:0.04em;
+  padding:7px 8px; border-radius:5px;
+  cursor:pointer;
+  border:1px solid rgba(205,163,73,0.25);
+  background:linear-gradient(160deg, rgba(255,255,255,0.04), rgba(0,0,0,0.15));
