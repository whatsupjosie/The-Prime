+/* Fine architectural line inside each silhouette. */
+.dashboard>.panel .panel-head:after{display:block!important;content:"";position:absolute;left:11%;right:11%;bottom:2px;width:auto;height:1px;background:linear-gradient(90deg,transparent,rgba(207,157,91,.48),transparent);opacity:.8}
+.dashboard>.panel .panel-head b:first-letter{color:#d2a062}
+
+/* Manuscript: remove nested boxes and make the reading surface feel like paper under glass. */
+.preview .editor{border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;position:relative}
+.preview .editor:before{content:"";position:absolute;inset:0;background:
+ radial-gradient(circle at 75% 18%,rgba(255,190,103,.055),transparent 28%),
+ linear-gradient(135deg,#111516,#0b0e0f 70%);border:1px solid rgba(205,153,83,.28);clip-path:polygon(3% 0,97% 0,100% 8%,100% 91%,96% 100%,4% 100%,0 91%,0 8%);z-index:0}
+.preview .manuscript{z-index:1;background:linear-gradient(115deg,rgba(26,25,23,.92),rgba(14,15,15,.95))!important;padding:40px 46px!important;box-shadow:inset 0 0 55px rgba(0,0,0,.32)!important}
