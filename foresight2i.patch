+.light-materials{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.light-material{border:1px solid rgba(200,150,85,.13);border-radius:12px;padding:8px;background:rgba(9,11,12,.72);color:#cdbda6;cursor:pointer;text-align:left}.light-material:hover,.light-material.selected{border-color:var(--user-accent);box-shadow:0 0 16px rgba(210,160,90,.11)}.light-material .swatch{height:25px;border-radius:8px;margin-bottom:6px;box-shadow:inset 0 1px 0 rgba(255,255,255,.18),inset 0 -8px 16px rgba(0,0,0,.22),0 4px 12px rgba(0,0,0,.18)}.light-material b{display:block;font-size:8px}.light-material small{display:block;color:#766c60;font-size:7px;margin-top:2px}
