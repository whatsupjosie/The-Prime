+let flagIdCounter = 1;
+function nextFlagId() { return 'flag_' + (flagIdCounter++) + '_' + Date.now().toString(36); }
+
+const CONTINUITY_SYSTEM_PROMPT = 'You are a continuity editor. Compare these chapter summaries and character records. ' +
+  'Find contradictions, orphaned setups, timeline errors. Return only genuine issues, not style preferences. ' +
+  'Return JSON only — no prose, no markdown fences. Schema:\n' +
+  '{ "findings": [{ "severity": "error"|"warning"|"info", "type": string, "message": string }] }';
+
+function buildContinuityUserPrompt(idx) {
+  const chars = (intelligence.characters || []).map(c =>
+    `${c.name} — confirmed: [${(c.traits.confirmed || []).join(', ')}], inferred: [${(c.traits.inferred || []).join(', ')}]`
+  ).join('\n') || 'none yet';
+  const threads = (intelligence.plot_threads || []).map(t => `${t.label} — status: ${t.status}`).join('\n') || 'none yet';
+  const timeline = (intelligence.timeline || []).map(t => `ch${t.chapter + 1}: ${t.time_marker}`).join('\n') || 'none yet';
+  return `Known characters:\n${chars}\n\nPlot threads:\n${threads}\n\nTimeline:\n${timeline}\n\n` +
+    `Updated chapter (${idx + 1}) text:\n${chapterText(idx)}`;
+}
+function parseContinuityReply(reply) {
+  const cleaned = reply.trim().replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();
+  try { return JSON.parse(cleaned); } catch { return null; }
+}
+
+// Adds new findings to intelligence.continuity_flags, skipping anything
+// that matches an already-dismissed flag (same type + message).
+function mergeContinuityFlags(idx, findings) {
+  if (!Array.isArray(findings)) return [];
+  const added = [];
+  findings.forEach(f => {
+    if (!f || !f.message) return;
+    const alreadyDismissed = intelligence.continuity_flags.some(existing =>
+      existing.status === 'dismissed' && existing.type === f.type && existing.message === f.message);
+    if (alreadyDismissed) return;
+    const alreadyActive = intelligence.continuity_flags.some(existing =>
+      existing.status !== 'dismissed' && existing.type === f.type && existing.message === f.message);
+    if (alreadyActive) return;
+    const flag = {
+      id: nextFlagId(),
+      severity: ['error', 'warning', 'info'].includes(f.severity) ? f.severity : 'warning',
+      type: f.type || 'continuity',
+      message: f.message,
+      chapters: [idx],
+      dismissed: false,
+      status: 'active'
+    };
+    intelligence.continuity_flags.push(flag);
+    added.push(flag);
+  });
+  return added;
+}
+
+function renderContinuityFlag(flag) {
+  const div = document.createElement('div');
+  div.className = 'chat-msg pp continuity-flag';
+  div.dataset.flagId = flag.id;
+  const icon = flag.severity === 'error' ? '⚠' : (flag.severity === 'warning' ? '◆' : 'ℹ');
+  div.innerHTML = '<span class="who">PubPartner</span>' + icon + ' ' + escHtml(flag.message);
+
+  const actions = document.createElement('div');
+  actions.className = 'continuity-flag-actions';
+
+  const dismissBtn = document.createElement('button');
+  dismissBtn.textContent = 'Dismiss';
+  dismissBtn.onclick = () => { setFlagStatus(flag.id, 'dismissed'); actions.remove(); div.classList.add('flag-dismissed'); };
+
+  const laterBtn = document.createElement('button');
+  laterBtn.textContent = 'Flag for later';
+  laterBtn.onclick = () => { actions.remove(); div.classList.add('flag-deferred'); };
+
+  const fixBtn = document.createElement('button');
+  fixBtn.textContent = 'Fix now';
+  fixBtn.onclick = () => {
+    const targetChapter = flag.chapters && flag.chapters[0] != null ? flag.chapters[0] : 0;
+    const { start } = chapterBounds(targetChapter);
+    selectedIdx = Math.min(start, Math.max(0, committed.length - 1));
+    render();
+    actions.remove(); div.classList.add('flag-jumped');
+  };
