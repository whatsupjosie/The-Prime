+<style id="foresight-refinement-v5">
+/* ==========================================================
+   V5 — ART DECO / ORGANIC COUNTER REFINEMENT
+   The goal is not to decorate rectangles. The goal is to make
+   each tray feel like a different piece of crafted hardware.
+   ========================================================== */
+:root{
+  --ink0:#07090a; --ink1:#0d1112; --ink2:#151718;
+  --bronze:#8d6031; --bronze-hi:#d2a062; --champagne:#ead6b5;
+  --violet:#78618f; --violet-hi:#b49bc7; --warm-glow:rgba(222,168,92,.18);
+}
+body{background:
+  radial-gradient(ellipse at 18% 8%,rgba(101,65,34,.18),transparent 30%),
+  radial-gradient(ellipse at 82% 15%,rgba(89,62,36,.12),transparent 30%),
+  radial-gradient(ellipse at 50% 100%,rgba(88,57,33,.11),transparent 42%),
