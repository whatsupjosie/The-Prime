+  display:flex!important;                     /* v15 had hidden this outright */
+  position:fixed;left:50%;bottom:14px;transform:translateX(-50%);
+  gap:6px;padding:7px 10px;z-index:900;
+  background:rgba(10,13,15,.82);
+  border:1px solid color-mix(in srgb,var(--user-accent,#c98f4a) 30%,transparent);
+  border-radius:999px;
