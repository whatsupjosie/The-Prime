+<style id="foresight-v18-polygon-trays">
+/* ───────────────────────────────────────────────────────────────────────
+   V18 — POLYGONAL TRAYS + TRAY LAUNCHER
+   Replaces the rectangular tray chrome with spec-compliant irregular
+   polygons, and restores the tray show/hide menu.
+
+   Deliberately does NOT touch position or size: trays live on the counter
+   and the freeform workspace owns where they sit. This layer only changes
+   what a tray *looks like*, never where it *is*.
+
+   Shared visual grammar is non-negotiable — every family uses the same
+   stroke recipe, glow behaviour, gradient and light logic.
+   ─────────────────────────────────────────────────────────────────────── */
+
+/* The polygon becomes the surface, so the box drops its rectangular chrome.
+   Width/height/left/top are left alone — the counter owns those. */
+:root[data-tray-geometry="polygonal"] .panel{
+  background:none!important;
+  border:0!important;
+  border-radius:0!important;
+  box-shadow:none!important;
+  overflow:visible!important;
+}
+
+.tray-shape{
+  position:absolute;inset:0;width:100%;height:100%;
+  pointer-events:none;z-index:0;overflow:visible;
+}
+.tray-shape .tray-fill{fill:rgba(15,19,22,.86)}
+.tray-shape .tray-stroke{
+  fill:none;
+  stroke:var(--user-accent,#c98f4a);
+  stroke-width:1.4;
+  stroke-opacity:.72;
+  /* Softened perimeter — the unifier that makes every family read as a set. */
+  filter:url(#trayFeather);
+  transition:stroke-opacity .25s ease;
+}
+.tray-shape .tray-glow{
+  fill:none;stroke:var(--user-accent,#c98f4a);stroke-width:7;
+  filter:url(#trayFeather);opacity:.2;transition:opacity .25s ease;
+}
+
+/* Focus/glow response is identical regardless of silhouette. */
+.panel:hover .tray-stroke,.panel:focus-within .tray-stroke{stroke-opacity:1}
+.panel:hover .tray-glow,.panel:focus-within .tray-glow{opacity:.46}
+.panel.tray-collision .tray-stroke{stroke:#e6b073;stroke-opacity:.95}
+
+/* Tray content sits in the exact rectangle the fitter verified fits inside
+   the silhouette — expressed in percentages, so it holds when the tray is
+   resized on the counter. Not padding: padding guesses, this is measured. */
+:root[data-tray-geometry="polygonal"] .panel>.tray-content{
+  position:absolute;z-index:1;
+  left:var(--content-left);top:var(--content-top);
+  width:var(--content-width);height:var(--content-height);
+  display:flex;flex-direction:column;
+  /* Scroll rather than clip: a status list or long transcript legitimately
+     exceeds its visible box, and hiding the overflow loses content silently.
+     The requirement guarantees the *visible* minimum, not the total. */
+  overflow:auto;overscroll-behavior:contain;
+}
+:root[data-tray-geometry="polygonal"] .panel>.tray-content>*{min-height:0;flex-shrink:0}
+:root[data-tray-geometry="polygonal"] .panel>.tray-content::-webkit-scrollbar{width:5px}
+:root[data-tray-geometry="polygonal"] .panel>.tray-content::-webkit-scrollbar-thumb{
+  background:color-mix(in srgb,var(--user-accent,#c98f4a) 40%,transparent);border-radius:4px}
+
+/* ── Tray launcher — restores show/hide, which renderMenu() left unbuilt ── */
