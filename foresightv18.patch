+"""
+Export fitted tray geometry for the Foresight counter.
+
+Each tray on the counter hosts a module, and each module declares the space it
+needs (tray_requirements). This runs the fit and emits, per tray:
+
+  * the silhouette path            — spec-compliant, from polygon_shape_library
+  * the tray's natural size        — the smallest box that satisfies the module
+  * the exact content box          — where the module's block actually lands,
+                                     as percentages so it survives resizing
+
+The browser never computes geometry: it consumes this. That keeps the design
+rules and the fit logic in Python, where they are tested.
+"""
+
+import json
+from typing import Dict
+
+from tray_requirements import MODULE_REQUIREMENTS, TrayFitError, fit_tray
+
+# Which module each tray on the counter hosts. The tray id is the CSS class
+# already present in the UI markup (.panel.preview, .panel.chat, ...).
+TRAY_MODULES: Dict[str, str] = {
+    "preview": "live_preview",
+    "status":  "status_panel",
+    "chat":    "conversation",
+    "files":   "file_browser",
+    "memory":  "memory_cluster",
+    "tools":   "tool_cluster",
+    "output":  "work_output",
+    "quick":   "quick_actions",
+}
+
+
+def build() -> Dict[str, dict]:
+    out: Dict[str, dict] = {}
+    for tray_id, module in TRAY_MODULES.items():
+        try:
+            fitted = fit_tray(module, seed=tray_id)
+        except TrayFitError as exc:
+            # Loud, not silent — a tray whose content cannot fit is a bug.
+            print(f"  !! {tray_id}: {exc}")
+            continue
+
+        sil = fitted.silhouette
+        box = fitted.content_box
+        w, h = sil.width, sil.height
+
+        out[tray_id] = {
+            "module": module,
+            "label": fitted.requirement.label,
+            "family": sil.family,
+            "path": sil.to_svg_path(),
+            "viewBox": f"0 0 {w:.0f} {h:.0f}",
+            "feather": round(sil.feather, 3),
+            # Natural size: what the counter should use before the user drags.
+            "natural": {"w": round(w), "h": round(h)},
+            # Content box as percentages of the tray, so it holds on resize.
+            "content": {
+                "leftPct":   round(box["x"] / w * 100, 3),
+                "topPct":    round(box["y"] / h * 100, 3),
+                "widthPct":  round(box["width"] / w * 100, 3),
+                "heightPct": round(box["height"] / h * 100, 3),
+            },
+            # Minimums, so the counter can refuse a resize that would break
+            # the module rather than letting content overflow.
+            "minContent": {
+                "w": fitted.requirement.min_content_w,
+                "h": fitted.requirement.min_content_h,
+            },
+            "efficiency": round(fitted.efficiency, 3),
+        }
+    return out
+
+
+if __name__ == "__main__":
+    data = build()
+    with open("tray_silhouettes.json", "w", encoding="utf-8") as fh:
+        json.dump(data, fh, indent=1)
+    print(f"exported {len(data)} fitted trays -> tray_silhouettes.json")
+    for tid, d in data.items():
+        c = d["content"]
+        print(f"  {tid:8s} {d['family']:9s} {d['natural']['w']:>4}x{d['natural']['h']:<4} "
+              f"content {c['widthPct']:.0f}%x{c['heightPct']:.0f}% "
+              f"@ {c['leftPct']:.0f}%,{c['topPct']:.0f}%  ({d['label']})")
