(135deg,#f5f2e8,#8b8a86,#f6f5ef);--material-vein:repeating-linear-gradient(118deg,transparent 0 12px,#2b2c2d 13px 15px,transparent 16px 24px)}.material-choice.marble-gb .material-chip{--material-base:linear-gradient(135deg,#173f39,#3f7f75,#183d4b);--material-vein:repeating-linear-gradient(120deg,transparent 0 12px,#a5d6c5 13px 14px,transparent 15px 25px)}.material-choice.marble-gw .material-chip{--material-base:linear-gradient(135deg,#edf1e6,#9ebd9d,#f4f4e9);--material-vein:repeating-linear-gradient(120deg,transparent 0 12px,#426e4b 13px 15px,transparent 16px 25px)}.material-choice.marble-light-green .material-chip{--material-base:linear-gradient(135deg,#e6f1db,#a9c995,#eaf0df);--material-vein:repeating-linear-gradient(120deg,transparent 0 12px,#6b965e 13px 14px,transparent 15px 25px)}
