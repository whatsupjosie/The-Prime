+<style id="foresight-marquee">
+/* ============================================================
+   FORESIGHT MARQUEE — the outer frame of the Counter window
+   Inspired by the user's selected Art Deco reference:
+   thin architectural linework, restrained ornament, open bottom.
+   This is a window frame, not a tray.
+   ============================================================ */
+.app{
+  position:relative;
+  border:0!important;
+  border-radius:0!important;
+  overflow:visible!important;
+  background:transparent!important;
+  box-shadow:none!important;
+}
+.app:before{
+  content:"";
+  position:absolute;
+  z-index:900000;
+  pointer-events:none;
+  inset:0;
+  border:1px solid rgba(177,123,61,.82);
+  border-bottom:0;
+  clip-path:polygon(0 0,100% 0,100% 100%,calc(100% - 18px) 100%,calc(100% - 18px) 100%,18px 100%,18px 100%,0 100%);
+  box-shadow:inset 0 1px 0 rgba(255,221,173,.16),0 0 0 1px rgba(57,39,25,.75);
+}
+.app:after{
+  content:"";
+  position:absolute;
+  z-index:900001;
+  pointer-events:none;
+  top:0;left:0;right:0;height:34px;
+  background:
+    linear-gradient(90deg,transparent 0,rgba(179,123,61,.72) 18px,transparent 19px) left top/42px 1px no-repeat,
+    linear-gradient(90deg,transparent 0,rgba(179,123,61,.72) 18px,transparent 19px) right top/42px 1px no-repeat,
+    linear-gradient(90deg,transparent 0,rgba(179,123,61,.42) 38%,rgba(213,158,86,.9) 50%,rgba(179,123,61,.42) 62%,transparent 100%) center 0/320px 1px no-repeat;
+}
+/* Four restrained corner constructions, with the lower corners intentionally
+   open so the application reads as a framed window rather than a box. */
+.marquee-corner{position:absolute;z-index:900002;width:30px;height:30px;pointer-events:none}
+.marquee-corner:before,.marquee-corner:after{content:"";position:absolute;background:#b67c3f;box-shadow:0 0 5px rgba(203,146,74,.18)}
+.marquee-corner.tl{left:0;top:0}.marquee-corner.tr{right:0;top:0}
+.marquee-corner.tl:before,.marquee-corner.tr:before{top:7px;width:26px;height:1px}.marquee-corner.tl:after,.marquee-corner.tr:after{left:7px;width:1px;height:22px}
+.marquee-corner.tr:before{right:0}.marquee-corner.tr:after{right:7px;left:auto}
+.marquee-ornament{
+  position:absolute;z-index:900003;top:-1px;left:50%;transform:translateX(-50%);
+  width:168px;height:25px;pointer-events:none;display:flex;align-items:flex-start;justify-content:center;
+}
+.marquee-ornament:before{
+  content:"";position:absolute;top:9px;left:0;right:0;height:1px;
+  background:linear-gradient(90deg,transparent,#9c6836 14%,#d29a52 42%,#e0b16c 50%,#d29a52 58%,#9c6836 86%,transparent);
+}
+.marquee-ornament .diamond{
+  position:relative;margin-top:2px;width:14px;height:14px;transform:rotate(45deg);
+  border:1px solid #c18a4c;background:#0c0e0f;box-shadow:0 0 0 3px rgba(9,11,12,.94),0 0 8px rgba(194,138,76,.18)
+}
+.marquee-ornament .diamond:after{content:"";position:absolute;inset:3px;border:1px solid #8d5e31}
