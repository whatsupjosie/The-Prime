+.panel.memory{--shape:polygon(50% 0,88% 7%,98% 28%,100% 70%,88% 93%,50% 100%,12% 93%,0 70%,2% 28%,12% 7%)}
+.panel.tools{--shape:polygon(12% 0,88% 0,100% 18%,96% 84%,86% 100%,12% 100%,0 84%,4% 18%)}
+.panel.output{--shape:polygon(8% 0,92% 0,100% 15%,100% 84%,92% 100%,8% 100%,0 84%,0 16%)}
+.panel.quick{--shape:polygon(17% 0,83% 0,100% 18%,100% 82%,84% 100%,16% 100%,0 82%,0 18%)}
+
+/* Fine architectural line inside each silhouette. */
+.dashboard>.panel .panel-head:after{display:block!important;content:"";position:absolute;left:11%;right:11%;bottom:2px;width:auto;height:1px;background:linear-gradient(90deg,transparent,rgba(207,157,91,.48),transparent);opacity:.8}
+.dashboard>.panel .panel-head b:first-letter{color:#d2a062}
+
+/* Manuscript: remove nested boxes and make the reading surface feel like paper under glass. */
+.preview .editor{border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;position:relative}
+.preview .editor:before{content:"";position:absolute;inset:0;background:
+ radial-gradient(circle at 75% 18%,rgba(255,190,103,.055),transparent 28%),
+ linear-gradient(135deg,#111516,#0b0e0f 70%);border:1px solid rgba(205,153,83,.28);clip-path:polygon(3% 0,97% 0,100% 8%,100% 91%,96% 100%,4% 100%,0 91%,0 8%);z-index:0}
+.preview .manuscript{z-index:1;background:linear-gradient(115deg,rgba(26,25,23,.92),rgba(14,15,15,.95))!important;padding:40px 46px!important;box-shadow:inset 0 0 55px rgba(0,0,0,.32)!important}
+.preview .manuscript:after{content:"";position:absolute;top:18px;right:24px;width:46px;height:46px;border:1px solid rgba(203,151,83,.25);transform:rotate(45deg);opacity:.45}
+.preview .margin{z-index:1;background:rgba(9,12,13,.7)!important;border-left:1px solid rgba(198,143,78,.25)!important;width:72px!important}
+.preview .para{border-left:0!important;padding:4px 0!important}
+.preview .para:hover{background:rgba(203,151,83,.05)!important}
+
+/* Files: editorial plaques, not four equal cards. */
+.file-row{grid-template-columns:1.25fr 1fr 1fr .86fr!important;gap:12px!important}
+.file .thumb{height:90px;border-radius:0!important;background:
+ linear-gradient(145deg,rgba(76,49,27,.35),rgba(10,13,14,.4)),
+ repeating-linear-gradient(90deg,transparent 0 17px,rgba(210,160,91,.035) 18px 19px)!important;border:1px solid rgba(199,145,80,.18);position:relative}
+.file .thumb:after{content:"";position:absolute;inset:8px;border:1px solid rgba(208,158,90,.25);clip-path:polygon(8% 0,92% 0,100% 12%,100% 88%,92% 100%,8% 100%,0 88%,0 12%)}
+
+/* Memory: six petal medallions around a visual center. */
+.memory-grid{grid-template-columns:repeat(3,1fr)!important;gap:5px!important;padding:4px 22px 20px!important}
+.memory-cell{min-height:70px!important}
+.memory-cell:before{clip-path:polygon(50% 0,83% 12%,100% 50%,83% 88%,50% 100%,17% 88%,0 50%,17% 12%)!important;background:radial-gradient(circle at 50% 38%,#e5d8bf,#b8a68b 78%)!important}
+.memory-cell span{font-size:15px!important;color:#6f512f!important}.memory-cell strong{font-size:9px!important;letter-spacing:.04em;text-transform:uppercase}
+
+/* Tool palette: one large compass-like focal control + satellites. */
+.tool-grid{grid-template-columns:repeat(3,1fr)!important;gap:4px!important;padding:5px 22px 18px!important}
+.tool{min-height:58px!important}
+.tool:before{clip-path:polygon(50% 0,88% 8%,100% 50%,88% 92%,50% 100%,12% 92%,0 50%,12% 8%)!important;background:radial-gradient(circle at 50% 34%,rgba(45,42,37,.96),rgba(11,14,15,.98))!important;border:1px solid rgba(207,155,86,.27)!important}
+.tool:after{content:"·"!important;right:50%!important;top:2px!important;color:#d0a062!important}
+.tool .ico{font-size:15px!important;margin-bottom:3px!important}
+
+/* Conversation becomes a softer asymmetric dialogue chamber. */
+.chat .msg{border:0!important;background:rgba(26,25,26,.65)!important;position:relative;box-shadow:none!important}
+.chat .msg:before{content:"";position:absolute;inset:0;border:1px solid rgba(190,139,80,.19);clip-path:polygon(8% 0,94% 0,100% 18%,100% 82%,92% 100%,7% 100%,0 82%,0 18%);pointer-events:none}
+.chat .msg.you{background:rgba(53,40,57,.46)!important}.chat-body{padding:7px 24px 16px!important}
+.chat-input{border-radius:999px!important;background:rgba(9,11,12,.7)!important;border-color:rgba(197,145,79,.34)!important;padding-left:14px!important}
+
+/* Output: pale vellum insert, with an actual frame rather than a card. */
+.panel.output:before{background:linear-gradient(145deg,#e8ddc8,#b9aa90)!important}
+.panel.output:after{border-color:rgba(106,76,43,.45)!important}
+.output .output-body:before{clip-path:polygon(4% 0,96% 0,100% 12%,100% 88%,96% 100%,4% 100%,0 88%,0 12%)!important;background:linear-gradient(145deg,#eee3cf,#c9baa0)!important;box-shadow:inset 0 0 0 1px rgba(93,67,41,.22)!important}
+
+/* Status gauge becomes a brass instrument rather than a modern dashboard donut. */
+.gauge{background:conic-gradient(#d3a15d 0 349deg,rgba(49,45,39,.8) 349deg)!important;box-shadow:0 0 28px rgba(204,148,72,.09),inset 0 0 0 1px rgba(230,186,112,.2)}
+.gauge:before{content:"";position:absolute;inset:5px;border-radius:50%;border:1px solid rgba(226,181,108,.25)}
+
+/* Fan: less card-stack, more Art Deco mechanical fan. */
+#systemFan .blade:before{clip-path:polygon(0 50%,8% 26%,28% 9%,74% 7%,100% 50%,74% 93%,28% 91%,8% 74%)!important}
+#systemFan .blade:after{clip-path:polygon(0 50%,10% 30%,30% 13%,72% 11%,96% 50%,72% 89%,30% 87%,10% 70%)!important}
+#systemFan .blade{padding-left:58px!important}
+
+/* Top-left hub is now visibly attached to the frame, not floating in the workspace. */
+#systemFan{left:12px!important;top:9px!important;width:620px!important;height:175px!important}
+#systemFan .fan-hub{width:58px!important;height:58px!important;top:1px!important;box-shadow:0 0 0 3px rgba(8,10,11,.85),0 8px 24px rgba(0,0,0,.5),0 0 22px rgba(208,151,75,.16)!important}
+#systemFan .fan-arm{left:51px!important;top:30px!important;width:62px!important}
+#systemFan .fan-axis{left:101px!important;top:-1px!important;width:58px!important;height:58px!important}
+#systemFan .blades{left:135px!important;top:-12px!important}
+
+/* The Counter is the quietest surface: the architecture should frame it, not fight it. */
+.footer{background:linear-gradient(180deg,rgba(8,10,11,.7),rgba(5,7,8,.9))!important}
+
+/* Small screens fall back to the silhouette borders without destroying usability. */
+@media(max-width:900px){.dashboard>.panel:before,.dashboard>.panel:after{clip-path:none;border-radius:22px!important}.file-row{grid-template-columns:repeat(2,1fr)!important}.memory-grid{grid-template-columns:repeat(2,1fr)!important}}
+</style>
+
+<style id="foresight-v14-balance">
+/* V14: balance the tray family — not everything is a plaque. */
