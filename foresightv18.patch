+<style id="foresight-v18-polygon-trays">
+/* ───────────────────────────────────────────────────────────────────────
+   V18 — POLYGONAL TRAYS + TRAY LAUNCHER
+   Replaces the rectangular tray chrome with spec-compliant irregular
+   polygons, and restores the tray show/hide menu.
+
+   Deliberately does NOT touch position or size: trays live on the counter
+   and the freeform workspace owns where they sit. This layer only changes
+   what a tray *looks like*, never where it *is*.
+
+   Shared visual grammar is non-negotiable — every family uses the same
+   stroke recipe, glow behaviour, gradient and light logic.
+   ─────────────────────────────────────────────────────────────────────── */
+
+/* The polygon becomes the surface, so the box drops its rectangular chrome.
+   Width/height/left/top are left alone — the counter owns those. */
+:root[data-tray-geometry="polygonal"] .panel{
+  background:none!important;
+  border:0!important;
+  border-radius:0!important;
+  box-shadow:none!important;
+  overflow:visible!important;
+}
+
+.tray-shape{
+  position:absolute;inset:0;width:100%;height:100%;
+  pointer-events:none;z-index:0;overflow:visible;
+}
+.tray-shape .tray-fill{fill:rgba(15,19,22,.86)}
+.tray-shape .tray-stroke{
+  fill:none;
+  stroke:var(--user-accent,#c98f4a);
+  stroke-width:1.4;
+  stroke-opacity:.72;
+  /* Softened perimeter — the unifier that makes every family read as a set. */
+  filter:url(#trayFeather);
+  transition:stroke-opacity .25s ease;
+}
+.tray-shape .tray-glow{
+  fill:none;stroke:var(--user-accent,#c98f4a);stroke-width:7;
+  filter:url(#trayFeather);opacity:.2;transition:opacity .25s ease;
+}
+
+/* Focus/glow response is identical regardless of silhouette. */
+.panel:hover .tray-stroke,.panel:focus-within .tray-stroke{stroke-opacity:1}
+.panel:hover .tray-glow,.panel:focus-within .tray-glow{opacity:.46}
+.panel.tray-collision .tray-stroke{stroke:#e6b073;stroke-opacity:.95}
+
+/* Tray content sits in the exact rectangle the fitter verified fits inside
+   the silhouette — expressed in percentages, so it holds when the tray is
+   resized on the counter. Not padding: padding guesses, this is measured. */
+:root[data-tray-geometry="polygonal"] .panel>.tray-content{
+  position:absolute;z-index:1;
+  left:var(--content-left);top:var(--content-top);
+  width:var(--content-width);height:var(--content-height);
+  display:flex;flex-direction:column;
+  /* Scroll rather than clip: a status list or long transcript legitimately
+     exceeds its visible box, and hiding the overflow loses content silently.
+     The requirement guarantees the *visible* minimum, not the total. */
+  overflow:auto;overscroll-behavior:contain;
+}
+:root[data-tray-geometry="polygonal"] .panel>.tray-content>*{min-height:0;flex-shrink:0}
+:root[data-tray-geometry="polygonal"] .panel>.tray-content::-webkit-scrollbar{width:5px}
+:root[data-tray-geometry="polygonal"] .panel>.tray-content::-webkit-scrollbar-thumb{
+  background:color-mix(in srgb,var(--user-accent,#c98f4a) 40%,transparent);border-radius:4px}
+
+/* ── Tray launcher — restores show/hide, which renderMenu() left unbuilt ── */
+:root[data-tray-geometry="polygonal"] .tray-launcher{
+  display:flex!important;                     /* v15 had hidden this outright */
+  position:fixed;left:50%;bottom:14px;transform:translateX(-50%);
+  gap:6px;padding:7px 10px;z-index:900;
+  background:rgba(10,13,15,.82);
+  border:1px solid color-mix(in srgb,var(--user-accent,#c98f4a) 30%,transparent);
+  border-radius:999px;
+  box-shadow:0 10px 30px rgba(0,0,0,.55);
+  backdrop-filter:blur(9px);
+  max-width:min(92vw,880px);flex-wrap:wrap;justify-content:center;
+}
+.tray-launcher-btn{
+  font:inherit;font-size:9px;letter-spacing:.09em;text-transform:uppercase;
+  padding:5px 11px;border-radius:999px;cursor:pointer;
+  background:transparent;color:rgba(233,224,208,.55);
+  border:1px solid transparent;transition:all .15s ease;
+}
+.tray-launcher-btn:hover{color:#f2e7d5;border-color:color-mix(in srgb,var(--user-accent,#c98f4a) 45%,transparent)}
+.tray-launcher-btn[aria-pressed="true"]{
+  color:var(--user-accent,#c98f4a);
+  border-color:color-mix(in srgb,var(--user-accent,#c98f4a) 55%,transparent);
+  background:color-mix(in srgb,var(--user-accent,#c98f4a) 12%,transparent);
+}
+.tray-launcher-btn:focus-visible{outline:2px solid var(--user-accent,#c98f4a);outline-offset:2px}
+.panel.tray-hidden{display:none!important}
+</style>
+
+<script id="foresight-v18-polygon-trays-script">
+/* Paints the exported silhouettes onto the trays and restores the launcher.
+   Geometry is generated and validated in Python (polygon_shape_library.py,
+   covered by test_polygon_shape_library.py) and exported to
+   tray_silhouettes.json, so the browser can never drift from the rules. */
+(function () {
+  const SVG = 'http://www.w3.org/2000/svg';
+
+  // The counter's persisted tray layout. A tray present here has geometry the
+  // user arranged, and must not be resized out from under them.
+  let savedLayout = {};
+  try {
+    savedLayout = JSON.parse(localStorage.getItem('foresight.freeformTrays.v13') || '{}') || {};
+  } catch (e) { savedLayout = {}; }
+
+  function installFilter(feather) {
+    if (document.getElementById('trayFeatherDefs')) return;
+    const s = document.createElementNS(SVG, 'svg');
+    s.id = 'trayFeatherDefs';
+    s.setAttribute('width', '0'); s.setAttribute('height', '0');
+    s.style.cssText = 'position:absolute;width:0;height:0;pointer-events:none';
+    s.innerHTML =
+      '<defs><filter id="trayFeather" x="-25%" y="-25%" width="150%" height="150%">' +
+      '<feGaussianBlur stdDeviation="' + feather.toFixed(2) + '"/></filter></defs>';
+    document.body.appendChild(s);
+  }
+
+  function paint(panel, spec) {
+    if (panel.querySelector(':scope > .tray-shape')) return;
+
+    // Wrap existing children so they sit inside the polygon, not its bbox.
+    const content = document.createElement('div');
+    content.className = 'tray-content';
+    while (panel.firstChild) content.appendChild(panel.firstChild);
+
+    const svg = document.createElementNS(SVG, 'svg');
+    svg.setAttribute('class', 'tray-shape');
+    svg.setAttribute('viewBox', spec.viewBox);
+    svg.setAttribute('preserveAspectRatio', 'none');
+    svg.setAttribute('aria-hidden', 'true');
+    ['tray-glow', 'tray-fill', 'tray-stroke'].forEach(cls => {
+      const p = document.createElementNS(SVG, 'path');
+      p.setAttribute('d', spec.path);
+      p.setAttribute('class', cls);
+      svg.appendChild(p);
+    });
+
+    panel.appendChild(svg);
+    panel.appendChild(content);
+
+    // Place content in the measured box, not a guessed inset.
+    const c = spec.content;
+    panel.style.setProperty('--content-left', c.leftPct + '%');
+    panel.style.setProperty('--content-top', c.topPct + '%');
+    panel.style.setProperty('--content-width', c.widthPct + '%');
+    panel.style.setProperty('--content-height', c.heightPct + '%');
+
+    // Natural size: the smallest tray that satisfies this module.
+    //
+    // Checked against the counter's persisted layout, NOT the inline style —
+    // the freeform workspace writes inline px geometry to every tray before
+    // this runs, so an inline-style check always looks "saved" and the fitted
+    // size would never apply.
+    // Size is applied by layout(), which scales the whole set to the counter.
+
+    // Publish the module's minimums so the counter can refuse a resize that
+    // would push content outside the silhouette.
+    panel.dataset.minContentW = spec.minContent.w;
+    panel.dataset.minContentH = spec.minContent.h;
+    panel.dataset.trayFamily = spec.family;
+    panel.dataset.trayModule = spec.module;
+  }
+
+  /*
+   * Lay the fitted trays out on the counter.
+   *
+   * Fitting a tray to its content changes its size, so the old coordinates no
+   * longer hold — without this the trays keep their previous positions, overlap
+   * badly and run off the edge. Runs only when the counter has no saved layout.
+   *
+   * Deliberately not a grid: trays are placed on a loose diagonal drift with
+   * varied row heights, then nudged apart. Rows and columns are exactly what
+   * this UI is trying not to be.
+   */
+  function layout(specs) {
+    const host = document.querySelector('.dashboard');
+    if (!host) return;
+    const pad = 18;
+    const availW = host.clientWidth - pad * 2;
+    const availH = host.clientHeight - pad * 2;
+
+    const items = Object.entries(specs)
+      .map(([id, s]) => ({ id, s, el: document.querySelector('.panel.' + id) }))
+      .filter(t => t.el && !t.el.classList.contains('tray-hidden'));
+    if (!items.length) return;
+
+    // Scale everything uniformly so the whole set fits the counter. Natural
+    // sizes are the smallest that satisfy each module, not a promise they all
+    // fit on screen together at 100%.
+    const totalArea = items.reduce((a, t) => a + t.s.natural.w * t.s.natural.h, 0);
+    // 0.62 leaves breathing room; trays are irregular so they never tile fully.
+    let scale = Math.sqrt((availW * availH * 0.62) / totalArea);
+    scale = Math.max(0.34, Math.min(1, scale));
+
+    // Biggest first — large trays are hardest to place, so seat them early.
+    items.sort((a, b) => (b.s.natural.w * b.s.natural.h) - (a.s.natural.w * a.s.natural.h));
+
+    const placed = [];
+    const overlaps = (x, y, w, h) => placed.some(r =>
+      x < r.x + r.w + 10 && x + w + 10 > r.x && y < r.y + r.h + 10 && y + h + 10 > r.y);
+
+    items.forEach((t, i) => {
+      const w = Math.round(t.s.natural.w * scale);
+      const h = Math.round(t.s.natural.h * scale);
+      let best = null;
+
+      // Scan for the first free spot, stepping coarsely. The diagonal start
+      // offset keeps successive trays from lining up into columns.
+      const step = 24;
+      const startX = (i % 2) * step;
+      for (let y = 0; y <= Math.max(0, availH - h) && !best; y += step) {
+        for (let x = startX; x <= Math.max(0, availW - w); x += step) {
+          if (!overlaps(x, y, w, h)) { best = { x, y }; break; }
+        }
+      }
+      // Nothing free: stagger it rather than dropping the tray.
+      if (!best) best = { x: (i * 37) % Math.max(1, availW - w), y: (i * 53) % Math.max(1, availH - h) };
+
+      placed.push({ x: best.x, y: best.y, w, h });
+      t.el.style.left = (pad + best.x) + 'px';
+      t.el.style.top = (pad + best.y) + 'px';
+      t.el.style.width = w + 'px';
+      t.el.style.height = h + 'px';
+    });
+  }
+
+  /* renderMenu() shipped as an empty stub, so hideTray()/showTray() were
+     reachable in code but had no UI. This rebuilds that launcher. */
+  function buildLauncher(ids) {
+    let bar = document.querySelector('.tray-launcher');
+    if (!bar) {
+      bar = document.createElement('div');
+      bar.className = 'tray-launcher';
+      bar.setAttribute('role', 'group');
+      bar.setAttribute('aria-label', 'Show or hide trays');
+      document.body.appendChild(bar);
+    }
+    bar.innerHTML = '';
+    ids.forEach(id => {
+      const panel = document.querySelector('.panel.' + id);
+      if (!panel) return;
+      const b = document.createElement('button');
+      b.className = 'tray-launcher-btn';
+      b.type = 'button';
+      b.textContent = id;
+      const sync = () => {
+        const on = !panel.classList.contains('tray-hidden');
+        b.setAttribute('aria-pressed', String(on));
+        b.title = (on ? 'Hide ' : 'Show ') + id + ' tray';
+      };
+      b.addEventListener('click', () => {
+        panel.classList.toggle('tray-hidden');
+        sync();
+      });
+      sync();
+      bar.appendChild(b);
+    });
+    return bar;
+  }
+
+  async function apply() {
+    let data;
+    try {
+      const res = await fetch('tray_silhouettes.json', { cache: 'no-store' });
+      if (!res.ok) throw new Error('HTTP ' + res.status);
+      data = await res.json();
+    } catch (e) {
+      // file:// or missing export — leave the tray chrome exactly as it was
+      // rather than half-applying the polygon treatment.
+      console.warn('[v18] silhouettes unavailable, keeping rectangular trays:', e.message);
+      return;
+    }
+
+    const ids = Object.keys(data);
+    installFilter(data[ids[0]] ? data[ids[0]].feather : 0.7);
+    ids.forEach(id => {
+      const panel = document.querySelector('.panel.' + id);
+      if (panel) paint(panel, data[id]);
+    });
+    document.documentElement.setAttribute('data-tray-geometry', 'polygonal');
+    if (!Object.keys(savedLayout).length) layout(data);
+    buildLauncher(ids);
+    // Re-flow on resize, but only while the user has not arranged the counter.
+    let t;
+    window.addEventListener('resize', () => {
+      if (Object.keys(savedLayout).length) return;
+      clearTimeout(t);
+      t = setTimeout(() => layout(data), 180);
+    });
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', apply);
+  } else {
+    apply();
+  }
+})();
+</script>
