+.marquee-ornament i.left{left:44px}.marquee-ornament i.right{right:44px}
+.marquee-ornament b{position:absolute;top:4px;width:5px;height:5px;border:1px solid #b97d3f;transform:rotate(45deg)}
+.marquee-ornament b.left{left:38px}.marquee-ornament b.right{right:38px}
+/* Keep the frame visually above the Counter but below the fan/modal. */
+.topbar,.dashboard,.footer{position:relative}
+@media(max-width:820px){.app:before{inset:0}.marquee-ornament{width:130px}.marquee-ornament i.left{left:25px}.marquee-ornament i.right{right:25px}.marquee-ornament b.left{left:19px}.marquee-ornament b.right{right:19px}}
+</style>
