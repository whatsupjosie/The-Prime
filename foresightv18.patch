+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Foresight — Counter / Morphable Tray Workspace</title>
+<!-- Legacy compatibility vocabulary retained while the Foresight Counter replaces the old fixed Control Room UI:
+PubCast V10 Unified Suite | WORD PROCESSOR & EDITING ENGINE | Check Manuscript | Format -> Screenplay | Format -> Stage Play | Style Analytics | Query Assistant |
+PubCast Control Room - Polygonal Tray Interface | LIVE VIEWPORT & CAMERA SWITCHER | PASSKEY GATE & AUTHORITY | TELEMETRY & SYSTEM LOG | ASSETS & RECORDING LIBRARY -->
+<meta name="legacy-ui" content="PubCast Control Room">
+<style>
+:root{
+  --bg:#090b0c; --bg2:#111416; --glass:#121719d9; --glass2:#171b1dd9;
+  --line:#8e6336; --line2:#c28a4c; --gold:#d9a35b; --cream:#efe0c6;
+  --text:#eadcc7; --muted:#918678; --green:#75a968; --blue:#6287b7;
+  --purple:#9273ad; --yellow:#c9a05a; --red:#a96557; --cyan:#79a8a4;
+  --shadow:0 24px 70px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.035);
+  --radius:24px;
+}
+*{box-sizing:border-box}
+html,body{margin:0;min-height:100%;background:
+ radial-gradient(circle at 50% 10%,#26201a 0,#0e1011 34%,#070809 75%);color:var(--text);
+ font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
+body{padding:18px}
+button,input,textarea{font:inherit}
+button{color:inherit}
+.app{max-width:1600px;margin:auto;border:1px solid #4e3824;border-radius:28px;overflow:hidden;background:linear-gradient(145deg,#111516,#090b0c);box-shadow:var(--shadow);min-height:calc(100vh - 36px)}
+.topbar{height:72px;position:relative;display:flex;align-items:center;border-bottom:1px solid #49331f;background:linear-gradient(180deg,#171a1b,#0d1011);padding:0 24px;gap:28px}
+.brand{display:flex;align-items:center;gap:12px;min-width:290px;padding-left:68px}.lamp{width:34px;height:44px;border:1px solid var(--gold);border-radius:50% 50% 44% 44%;display:grid;place-items:center;color:var(--gold);box-shadow:0 0 22px #b7793733}.lamp:after{content:'✦';font-size:15px}.brand h1{font-family:Georgia,serif;letter-spacing:.12em;font-size:22px;margin:0;color:#ecd8b8;font-weight:500}.nav{display:flex;gap:23px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#8e8273}.nav span.active{color:var(--gold)}.project{margin-left:auto;border:1px solid #5a432b;border-radius:18px;padding:10px 16px;color:#d8c5a7;background:#101415}.profile{display:flex;gap:10px;align-items:center;font-size:12px}.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--gold);color:var(--gold)}
+.dashboard{display:grid;grid-template-columns:290px minmax(520px,1fr) 330px;grid-template-rows:auto auto auto;gap:14px;padding:16px}
+.panel{position:relative;background:linear-gradient(145deg,rgba(24,29,30,.96),rgba(11,14,15,.96));border:1px solid #5d4229;border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}.panel:before{content:"";position:absolute;inset:1px;border:1px solid rgba(255,196,120,.07);border-radius:inherit;pointer-events:none}.panel:after{content:"";position:absolute;top:0;left:15%;right:15%;height:1px;background:linear-gradient(90deg,transparent,#d7a36277,transparent);pointer-events:none}.panel-head{display:flex;justify-content:space-between;align-items:center;padding:14px 17px 10px;color:#c9b79c;font-size:11px;letter-spacing:.1em;text-transform:uppercase}.panel-head b{font-weight:500}.dot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:6px;background:var(--green);box-shadow:0 0 8px currentColor}
