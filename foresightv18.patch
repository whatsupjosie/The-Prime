+.panel.status{--shape:polygon(7% 0,93% 0,98% 7%,100% 22%,100% 78%,94% 94%,76% 100%,24% 100%,6% 94%,0 78%,0 22%,2% 7%)}
+.panel.files{--shape:polygon(2% 0,98% 0,100% 4%,100% 96%,98% 100%,2% 100%,0 96%,0 4%)}
+.panel.output{--shape:polygon(6% 0,94% 0,100% 10%,100% 90%,94% 100%,6% 100%,0 90%,0 10%)}
+.panel.quick{--shape:polygon(20% 0,80% 0,100% 20%,100% 80%,80% 100%,20% 100%,0 80%,0 20%)}
+.panel.memory{--shape:polygon(50% 0,79% 7%,94% 24%,100% 50%,94% 76%,79% 93%,50% 100%,21% 93%,6% 76%,0 50%,6% 24%,21% 7%)}
+/* Keep the visual frame restrained: the tray skin supplies the shape, not a rectangular DOM border. */
+.dashboard>.panel{border-radius:0!important;}
+.dashboard>.panel .tray-action{border-radius:50%!important;}
+</style>
