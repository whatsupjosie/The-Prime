+.dashboard>.panel>*{position:relative;z-index:3;}
+.dashboard>.panel .tray-label,.dashboard>.panel .resize-grip{z-index:20!important;}
+/* The files become a family of small plaques rather than four cards in a row. */
+.files .file-row{align-items:stretch!important;}
