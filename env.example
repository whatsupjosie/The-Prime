## PubCast AI local development settings

# ---- Core app switches ----
# Allow local hosts to call the API (comma-separated list).
PUBCAST_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Only set to 1 if you need to send cookies across origins.
PUBCAST_CORS_CREDENTIALS=0
# Serve /data over HTTP (leave disabled outside dev).
PUBCAST_SERVE_DATA=0

# Enable recording session control endpoints in development.
PUBCAST_ENABLE_RECORDING=1
# Optional: start the single-process inference worker (uses modules/inference).
PUBCAST_ENABLE_INFERENCE_WORKER=0
# Optional: start the multi-process AI worker pool used by /api/ai/submit.
PUBCAST_ENABLE_AI_WORKERS=0

# Optional: protect admin endpoints (credentials summary, recording sessions) with a shared secret.
# Set the same key in the Control page's Recording panel to send X-Admin-Key automatically.
PUBCAST_ADMIN_KEY=change-me
# JWT signing key (ALWAYS override in non-dev).
PUBCAST_SECRET_KEY=change-me-too

# Optional: absolute path to ffmpeg/ffprobe if not on PATH.
# PUBCAST_FFMPEG=C:\Program Files\ffmpeg\bin\ffmpeg.exe
# PUBCAST_FFPROBE=C:\Program Files\ffmpeg\bin\ffprobe.exe

# Optional: LiveKit (for multi-party video in Conference room)
# If unset, the client falls back to local camera preview only.
# LIVEKIT_URL=https://your-livekit-domain
# LIVEKIT_API_KEY=lk_api_key
# LIVEKIT_API_SECRET=lk_api_secret

# ---- AI / inference settings ----
# Default agent ID to use for background inference jobs (must exist in config/models.yaml).
# PUBCAST_INFERENCE_AGENT=alex
# Whisper model to load when STT_PROVIDER=whisper.
PUBCAST_WHISPER_MODEL=small

# Provider API keys referenced by config/models.yaml entries (uncomment as needed).
# PUBCAST_OPENAI_KEY=sk-xxxx
# PUBCAST_GEMINI_KEY=ya29.xxxx
# PUBCAST_ANTHROPIC_KEY=anthropic-key
# PUBCAST_QWEN_KEY=qwen-key

# ---- Audio job behavior ----
PUBCAST_AUDIO_MAX_RETRIES=1
PUBCAST_AUDIO_BACKOFF=15
PUBCAST_AUDIO_AUTO_RETRY=1
PUBCAST_AUDIO_QUEUE=0

# ---- Media providers ----
# TTS_PROVIDER: browser (free) | azure (cloud) | piper (self-host)
TTS_PROVIDER=browser
# STT_PROVIDER: browser (free) | whisper (self-host)
STT_PROVIDER=browser
# VIDEO_PROVIDER: local (free preview) | livekit (self-host/cloud)
VIDEO_PROVIDER=local

# Azure Speech (optional server-side TTS with viseme-ready voices)
# AZURE_SPEECH_KEY=your_azure_speech_key
# AZURE_SPEECH_REGION=westus
# AZURE_SPEECH_VOICE=en-US-JennyNeural

# Piper (free, offline TTS) - set when TTS_PROVIDER=piper
# PIPER_BIN=piper
# PIPER_MODEL=C:\models\en_US-libritts-high.onnx
# PIPER_LENGTH_SCALE=1.0
# PIPER_NOISE_SCALE=0.667
